# https://EditorConfig.org

root = true

[*]
charset = utf-8
# maybe not use anymore so VCS handles it
end_of_line = lf
tab_width = 2
# Typically 80
max_line_length = 120
# indent_style = tab
# indent_size = tab
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
